{
  "name": "sharepoint-vault-site",
  "private": true,
  "type": "module",
  "description": "Static site build for sharepointvault.online: every article gets its own crawlable page in one IDE-style layout.",
  "scripts": {
    "build:site": "node tools/build-site.mjs _site && node tools/build-og.mjs _site && pagefind --site _site",
    "check": "node tools/check-vault.mjs"
  },
  "devDependencies": {
    "marked": "12.0.2",
    "pagefind": "1.1.1",
    "prismjs": "1.29.0",
    "puppeteer-core": "22.15.0"
  }
}
